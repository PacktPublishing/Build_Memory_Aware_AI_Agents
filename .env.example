# LLM for the Lab 1 turns and OAMP extraction/summaries, routed through LiteLLM.
# Default: xai.grok-4.3 on OCI Generative AI through its OpenAI-compatible API, hence `openai/`.
# Paste your own OCI Generative AI API key below (OCI Console > Analytics & AI > Generative AI >
# API keys). Optional: _2 and _3 add more keys on the same endpoint, and the FALLBACK lines add
# a second region that takes over when Phoenix rejects or rate-limits a call. In Codespaces,
# secrets with these names are copied in automatically (.devcontainer/env-from-secrets.sh).
OAMP_LLM=openai/xai.grok-4.3
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com/openai/v1
OCI_GENAI_API_KEY=
OCI_GENAI_API_KEY_2=
OCI_GENAI_API_KEY_3=
OCI_GENAI_FALLBACK_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
OCI_GENAI_FALLBACK_API_KEY=
OCI_GENAI_FALLBACK_API_KEY_2=
OCI_GENAI_FALLBACK_API_KEY_3=

# Bring your own provider instead: blank both OCI_GENAI_*ENDPOINT lines, set OAMP_LLM to a LiteLLM
# model string, and add the key it needs: gpt-4o-mini + OPENAI_API_KEY,
# anthropic/claude-sonnet-4-20250514 + ANTHROPIC_API_KEY, or ollama/llama3.1 (local server, no key).

# Embeddings run inside Oracle after `scripts/load_onnx_model.py` loads the ONNX model.
# You may switch to a LiteLLM embedding model string such as text-embedding-3-small.
OAMP_EMBEDDER=oracle-db

# Oracle AI Database local container defaults.
DB_USER=VECTOR
DB_PASSWORD=VectorPwd_2025
ORACLE_HOST_PORT=1526
DB_CONNECT_STRING=localhost:1526/FREEPDB1

# In-database ONNX model used by the toolbox/skillbox mini-lab.
# `scripts/load_onnx_model.py` loads this preset and registers this Oracle model name.
ORACLE_EMBED_PRESET=all-MiniLM-L12-v2
WORKSHOP_EMBED_MODEL=ALL_MINILM_L12_V2
