# LLM for the Lab 1 turns and OAMP extraction/summaries, routed through LiteLLM.
# The workshop ships shared OCI Generative AI keys (rotated after the session), so no personal
# key is needed. Six keys on the Phoenix endpoint, six on the Chicago endpoint as automatic
# failover; both serve xai.grok-4.3 through OCI's OpenAI-compatible API, hence `openai/`.
OAMP_LLM=openai/xai.grok-4.3
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com/openai/v1
OCI_GENAI_API_KEY=sk-QgeiytpLlTS7Jgrr3V1TUF4vLpTnwTCrQZ4Uz1cbQqbeYpQZ
OCI_GENAI_API_KEY_2=sk-2lPFPwil4q2UoEJOBmuMz21Mu34vxQQnwV3onYsNdQwX6KbT
OCI_GENAI_API_KEY_3=sk-pCABI4uiiKpUHRGRw6Qm4ZtJF364uFKz1dcXeEvJOFv2bjow
OCI_GENAI_API_KEY_4=sk-vYYu8aF9zgQn4PzEyURVlnjLpVDxcADx7S4YYD8vVHvoIa9K
OCI_GENAI_API_KEY_5=sk-6ckoiHSQGRx1yB35weEyjyWtuUTKgOwqIFzFWovNx9af3KFz
OCI_GENAI_API_KEY_6=sk-5925N6EPU0QUFuVHxne9KHs2RQYFsGzoqvt4583dGeUVQJPW
OCI_GENAI_FALLBACK_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
